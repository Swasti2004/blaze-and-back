# Copy these into your shell (export NAME=value) before starting the server.
# Every variable is optional; the defaults below are what the app uses.

# Local model served by Ollama. Swap this to try a different open-weight model.
OLLAMA_MODEL=gemma4
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT_S=120

# How far to look for places, and how precisely coordinates leave your machine.
TG_SEARCH_RADIUS_M=3000
TG_COORD_DECIMALS=3

# Set to true to allow suggestions after dark (off by default).
TG_ALLOW_AFTER_DARK=false

# Where feedback (accept / skip / done) is stored on this machine.
TG_DB_PATH=data/touchgrass.db
